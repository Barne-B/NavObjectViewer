<Window x:Class="NavObjectViewer.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NavObjectViewer"
        Title="Export selected objects" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <local:EnumMatchConverter x:Key="EnumMatch" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE74E;" FontSize="18"
                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                       Text="{Binding ObjectCount, StringFormat='Export {0:N0} selected object(s)'}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="OUTPUT FORMAT" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                <RadioButton Content="One combined file" GroupName="mode" Margin="0,3"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Combined}" />
                <RadioButton Content="Multiple files — one per object" GroupName="mode" Margin="0,3"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=PerObject}" />
                <CheckBox Content="Group into per-type subfolders (Table/, Codeunit/, …)"
                          Margin="28,4,0,0" IsChecked="{Binding GroupByType}"
                          Visibility="{Binding IsCombined, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding OutputPath}" IsReadOnly="True"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
        </Grid>

        <ProgressBar Grid.Row="3" Margin="0,14,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Background="{DynamicResource EditorBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         TextWrapping="Wrap" Background="Transparent" Padding="12"
                         Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Export" Width="112" Padding="0,8" Margin="0,0,10,0"
                    Command="{Binding ExportCommand}" />
            <Button Content="Close" Width="112" Padding="0,8" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
