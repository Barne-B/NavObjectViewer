<Window x:Class="NavObjectViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:NavObjectViewer"
        xmlns:vm="clr-namespace:NavObjectViewer.ViewModels"
        Title="NAV Object Viewer" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>

        <!-- Top toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Open File…" Command="{Binding OpenFileCommand}" Padding="10,3" />
                <Button Content="Open Folder…" Command="{Binding OpenFolderCommand}" Padding="10,3" />
                <Separator />
                <TextBlock Text="{Binding SourceLabel}" VerticalAlignment="Center" Margin="8,0"
                           Foreground="#FF666666" />
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="160" Height="12" Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="Total: " /><Run Text="{Binding TotalCount, Mode=OneWay, StringFormat=N0}" />
                    <Run Text="   Shown: " /><Run Text="{Binding VisibleCount, Mode=OneWay, StringFormat=N0}" />
                    <Run Text="   Selected: " /><Run Text="{Binding CheckedCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" MinWidth="520" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: filters + grid + selection bar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filters -->
                <GroupBox Grid.Row="0" Header="Filters" Margin="2">
                    <StackPanel Margin="4">
                        <ItemsControl ItemsSource="{Binding TypeToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}"
                                              Margin="0,0,12,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="180" Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Substring, or wildcard with * and ?" Margin="0,0,12,4" />
                            <TextBlock Text="ID from:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="70" Text="{Binding FilterIdMin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" />
                            <TextBlock Text="to:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="70" Text="{Binding FilterIdMax, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,4" />
                            <TextBlock Text="Version:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="120" Text="{Binding FilterVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,4" />
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <CheckBox Content="Modified only" IsChecked="{Binding ShowModifiedOnly}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <CheckBox Content="Anomalous only" IsChecked="{Binding ShowAnomalousOnly}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button Content="Custom range ≥50000" Command="{Binding PresetCustomRangeCommand}" Margin="0,0,8,0" Padding="8,2" />
                            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="8,2" />
                        </WrapPanel>

                        <Border Background="#22007ACC" BorderBrush="#55007ACC" BorderThickness="1" CornerRadius="3"
                                Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding ContentFilterActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ContentFilterLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="✕ Clear content filter" Command="{Binding ClearContentFilterCommand}" Padding="6,1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Object grid -->
                <DataGrid Grid.Row="1" Margin="2" ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Extended" GridLinesVisibility="Horizontal"
                          EnableRowVirtualization="True" HeadersVisibility="Column"
                          x:Name="ObjectsGrid">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="✓" Width="30" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="" Binding="{Binding Flag}" Width="24" IsReadOnly="True" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Version List" Binding="{Binding VersionList}" Width="130" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Mod" Binding="{Binding Modified, Mode=OneWay}" Width="44" IsReadOnly="True" />
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceFileName}" Width="120" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Selection bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,4">
                    <Button Content="Check shown" Command="{Binding CheckVisibleCommand}" Padding="8,3" Margin="0,0,6,0" />
                    <Button Content="Invert shown" Command="{Binding InvertVisibleCommand}" Padding="8,3" Margin="0,0,6,0" />
                    <Button Content="Clear selection" Command="{Binding UncheckAllCommand}" Padding="8,3" Margin="0,0,6,0" />
                    <Button Content="Export selected…" Padding="12,3"
                            FontWeight="SemiBold" Margin="16,0,0,0" x:Name="ExportButton" Click="ExportButton_Click" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22000000" />

            <!-- RIGHT: viewer + search tabs -->
            <TabControl Grid.Column="2" Margin="2">
                <TabItem Header="Viewer">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#11000000" Padding="6">
                            <TextBlock Text="{Binding ViewerHeader}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True"
                                               FontFamily="Consolas" FontSize="12" WordWrap="False"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Search">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="4"
                                         KeyDown="SearchBox_KeyDown" />
                                <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                                        Padding="14,4" Margin="6,0,0,0" />
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="Ignore case" IsChecked="{Binding SearchIgnoreCase}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <CheckBox Content="Regex" IsChecked="{Binding SearchUseRegex}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope}" Width="120" Margin="0,0,16,0" />
                                <Button Content="Filter list to matches" Command="{Binding FilterGridToMatchesCommand}"
                                        Padding="8,2" ToolTip="Show only the matching objects in the object list on the left" />
                            </WrapPanel>
                            <TextBlock Text="Double-click an object to open it; expand it to see the matching lines, then double-click a line to jump there."
                                       Foreground="#FF888888" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <TreeView Grid.Row="1" Margin="4" ItemsSource="{Binding SearchNodes}"
                                  x:Name="ResultsTree" MouseDoubleClick="ResultsTree_MouseDoubleClick"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:SearchNodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Header}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsObject}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsObject}" Value="False">
                                                        <Setter Property="FontFamily" Value="Consolas" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock Grid.Row="2" Margin="4,2" Text="{Binding SearchStatus}" Foreground="#FF666666" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
