<Window x:Class="NavObjectViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:NavObjectViewer"
        xmlns:vm="clr-namespace:NavObjectViewer.ViewModels"
        Title="NAV Object Viewer" Height="800" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:CountToVisibilityConverter x:Key="CountToVis" />
        <local:SearchScopeLabelConverter x:Key="ScopeLabel" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ App bar ============ -->
        <Border Grid.Row="0" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Height="58">
                    <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource Accent}"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="NAV Object Viewer" FontFamily="{StaticResource Font.Display}"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- source -->
                <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="16,0,0,0"
                        Visibility="{Binding SourceLabel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondary}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                </Border>

                <!-- actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource GhostButton}" Click="ThemeToggle_Click"
                            Padding="9,7" Margin="0,0,6,0">
                        <TextBlock x:Name="ThemeGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="15" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8E5;" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Open File" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8B7;" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="Open Folder" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1" Margin="14,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filters card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding TypeToggles}" Margin="0,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="0,3,14,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,7,0,9" />

                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="150" Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Substring, or wildcard with * and ?" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="ID" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="66" Text="{Binding FilterIdMin, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}" ToolTip="Minimum ID" />
                                <TextBlock Text="—" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="7,0" />
                                <TextBox Width="66" Text="{Binding FilterIdMax, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}" ToolTip="Maximum ID" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="Version" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="110" Text="{Binding FilterVersion, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Version list contains…" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,9,0,0">
                            <CheckBox Content="Modified only" IsChecked="{Binding ShowModifiedOnly}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <CheckBox Content="Anomalous only" IsChecked="{Binding ShowAnomalousOnly}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Content="≥ 50000" Command="{Binding PresetCustomRangeCommand}"
                                    Margin="0,0,4,0" ToolTip="Custom object range (ID ≥ 50000)" />
                            <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearFiltersCommand}"
                                    ToolTip="Clear all filters" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="#22E4A84C" BorderBrush="#55E4A84C"
                                    Visibility="{Binding ContentFilterActive, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE71C;" FontSize="11"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding ContentFilterLabel}" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding ClearContentFilterCommand}"
                                            Padding="5,1" Content="✕" Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Object grid card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <DataGrid Margin="6,6,6,6" ItemsSource="{Binding RowsView}"
                                  SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                                  SelectionMode="Extended" x:Name="ObjectsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="&#x2713;" Width="48" MinWidth="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="" Binding="{Binding Flag}" Width="30" MinWidth="26" IsReadOnly="True" CanUserResize="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding TypeName}" Width="88" MinWidth="64" IsReadOnly="True" />
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="74" MinWidth="56" IsReadOnly="True"
                                                    ElementStyle="{StaticResource MonoCell}" />
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="VERSION" Binding="{Binding VersionList}" Width="130" MinWidth="80" IsReadOnly="True"
                                                    ElementStyle="{StaticResource MonoCell}" />
                                <DataGridCheckBoxColumn Header="MOD" Binding="{Binding Modified, Mode=OneWay}" Width="54" MinWidth="44" IsReadOnly="True" />
                                <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="92" MinWidth="70" IsReadOnly="True"
                                                    ElementStyle="{StaticResource MonoCell}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                    Visibility="{Binding TotalCount, Converter={StaticResource CountToVis}}">
                            <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8A5;" FontSize="30"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No objects loaded" FontFamily="{StaticResource Font.Display}" FontSize="17"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,18,0,6" />
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                       Text="Open a C/AL object export (.txt), a binary object file (.fob) or a folder of them to browse, search and re-export objects." />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE8E5;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Open File" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action bar -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check shown" Command="{Binding CheckVisibleCommand}" Margin="0,0,8,0" />
                        <Button Content="Invert" Command="{Binding InvertVisibleCommand}" Margin="0,0,8,0" />
                        <Button Content="Clear selection" Command="{Binding UncheckAllCommand}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="16,8"
                            x:Name="ExportButton" Click="ExportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE74E;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Export selected" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- RIGHT -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                <TabControl>
                    <TabItem Header="Viewer">
                        <Grid Margin="8,4,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ViewerHeader}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource EditorBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    CornerRadius="8" ClipToBounds="True">
                                <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="12.5" WordWrap="False"
                                                       Background="{DynamicResource EditorBg}" Foreground="{DynamicResource EditorFg}"
                                                       LineNumbersForeground="{DynamicResource EditorLineNr}" Padding="8,6"
                                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Search">
                        <Grid Margin="8,4,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="SearchBox_KeyDown" />
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"
                                            Margin="8,0,0,0" Padding="16,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource Font.Icon}" Text="&#xE721;" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Search" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <WrapPanel Margin="0,10,0,4">
                                    <CheckBox Content="Ignore case" IsChecked="{Binding SearchIgnoreCase}" Margin="0,0,16,6" VerticalAlignment="Center" />
                                    <CheckBox Content="Regex" IsChecked="{Binding SearchUseRegex}" Margin="0,0,16,6" VerticalAlignment="Center" />
                                    <TextBlock Text="Scope" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                    <ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding SearchScope}" Width="176" Margin="0,0,12,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScopeLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Filter list to matches" Command="{Binding FilterGridToMatchesCommand}" Margin="0,0,0,6"
                                            ToolTip="Show only the matching objects in the object list on the left" />
                                </WrapPanel>
                                <TextBlock Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,10"
                                           Text="Results are grouped by object. Expand an object to load its matching lines, then double-click a line to jump there." />
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource EditorBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                                <TreeView Margin="4" ItemsSource="{Binding SearchNodes}" Background="Transparent"
                                          x:Name="ResultsTree" MouseDoubleClick="ResultsTree_MouseDoubleClick"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:SearchNodeViewModel}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsObject}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsObject}" Value="False">
                                                                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>

                            <TextBlock Grid.Row="2" Margin="2,8,2,0" Text="{Binding SearchStatus}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="12.5" />

                <ProgressBar Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="16,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding Progress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="TOTAL" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay, StringFormat=N0}" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="SHOWN" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding VisibleCount, Mode=OneWay, StringFormat=N0}" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Style="{StaticResource Chip}" Background="#22E4A84C" BorderBrush="#55E4A84C">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SELECTED" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding CheckedCount, Mode=OneWay, StringFormat=N0}" FontFamily="{StaticResource Font.Mono}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
