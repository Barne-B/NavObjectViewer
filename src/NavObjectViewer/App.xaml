<Application x:Class="NavObjectViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette is swapped at runtime by ThemeManager; controls reference it via DynamicResource. -->
                <ResourceDictionary Source="/Theme/Palette.Dark.xaml" />
                <ResourceDictionary Source="/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
