<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Marker used by ThemeManager to locate/replace the active palette. -->
    <sys:String x:Key="ThemeName">Light</sys:String>

    <SolidColorBrush x:Key="Bg" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0F2F6" />
    <SolidColorBrush x:Key="Hover" Color="#E9EDF3" />
    <SolidColorBrush x:Key="Line" Color="#DDE1E9" />
    <SolidColorBrush x:Key="LineSoft" Color="#EBEEF3" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1A2130" />
    <SolidColorBrush x:Key="TextSecondary" Color="#586274" />
    <SolidColorBrush x:Key="TextMuted" Color="#95A0B0" />
    <SolidColorBrush x:Key="Accent" Color="#C9860E" />
    <SolidColorBrush x:Key="AccentHover" Color="#B0750B" />
    <SolidColorBrush x:Key="AccentPressed" Color="#96640A" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sel" Color="#FBEFD5" />
    <SolidColorBrush x:Key="Danger" Color="#C6474C" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#55000000" />
    <SolidColorBrush x:Key="BarBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorBg" Color="#FBFBFD" />
    <SolidColorBrush x:Key="EditorFg" Color="#1A2130" />
    <SolidColorBrush x:Key="EditorLineNr" Color="#AEB7C4" />

    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFBFC" Offset="0" />
        <GradientStop Color="#F0F2F6" Offset="0.6" />
    </LinearGradientBrush>

</ResourceDictionary>
