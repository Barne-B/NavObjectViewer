<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Marker used by ThemeManager to locate/replace the active palette. -->
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <SolidColorBrush x:Key="Bg" Color="#0C0F15" />
    <SolidColorBrush x:Key="Surface" Color="#141922" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1A202B" />
    <SolidColorBrush x:Key="Hover" Color="#212936" />
    <SolidColorBrush x:Key="Line" Color="#242C39" />
    <SolidColorBrush x:Key="LineSoft" Color="#1B2029" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#98A4B6" />
    <SolidColorBrush x:Key="TextMuted" Color="#5D6675" />
    <SolidColorBrush x:Key="Accent" Color="#E4A84C" />
    <SolidColorBrush x:Key="AccentHover" Color="#F2BE6E" />
    <SolidColorBrush x:Key="AccentPressed" Color="#C68F3A" />
    <SolidColorBrush x:Key="OnAccent" Color="#161009" />
    <SolidColorBrush x:Key="Sel" Color="#2C2617" />
    <SolidColorBrush x:Key="Danger" Color="#E67B80" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="BarBg" Color="#0F131B" />
    <SolidColorBrush x:Key="EditorBg" Color="#0A0D13" />
    <SolidColorBrush x:Key="EditorFg" Color="#E8EDF4" />
    <SolidColorBrush x:Key="EditorLineNr" Color="#4C5563" />

    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12161F" Offset="0" />
        <GradientStop Color="#0C0F15" Offset="0.55" />
    </LinearGradientBrush>

</ResourceDictionary>
